# Comments must be on their own line: git treats "#" after a pattern as part of the pattern.

# Secrets and local config
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*

# Generated data and build output
data/
build/
dist/
*.egg-info/
spark-warehouse/
metastore_db/
derby.log
checkpoints/
logs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/

# Airflow (local runs)
airflow.db
airflow.cfg
airflow-webserver.pid
simple_auth_manager_passwords.json.generated

# Terraform and Databricks (provider lock files are committed)
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
!*.tfvars.example
.databricks/

# Tableau extracts hold data; .twb workbooks are committed
*.hyper
*.twbx

# Editors and OS (VS Code: only the shared extension list is committed)
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Word and Excel lock files
~$*

# Temporary uploads
bundle-*.md
