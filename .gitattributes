# Store text files with LF line endings, regardless of OS.
# Bash scripts, Dockerfiles and Python must have LF to run in Docker and WSL.
* text=auto eol=lf

# Scripts
*.sh   text eol=lf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never convert, never diff as text
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.zip      binary
*.gz       binary
*.jar      binary
*.parquet  binary