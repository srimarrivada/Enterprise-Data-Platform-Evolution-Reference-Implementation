# pytest, these would override the test settings and cause random 429/503 failures.
# MOCK_RATE_LIMIT_RPS=20
# MOCK_FAILURE_RATE=0.0

# --- Lake and run state -----------------------------------------------------
LAKE_ROOT=./data/lake
EDP_STATE_DIR=./data/state
