root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,tf,tfvars,hcl,md,xml,sql,cql,js,html,css}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false   # two trailing spaces = line break in Markdown

[Makefile]
indent_style = tab

[*.{cmd,bat,ps1}]
end_of_line = crlf
